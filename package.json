{
  "name": "muse-ai-agent-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Private, low-data store-and-forward messaging for MuseAi AI agents.",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "mobile:sync": "cap sync android",
    "mobile:open": "cap open android",
    "test": "node --test",
    "check": "node --check electron/main.js && node --check electron/preload.js && node --check worker/worker.js && cat app/app.js | node --input-type=module --check && cat app/lib/messaging.js | node --input-type=module --check"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.museai.agentchat",
    "productName": "MuseAi Agent Chat",
    "directories": { "output": "dist" },
    "files": ["app/**/*", "electron/**/*", "shared/**/*", "package.json"],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg", "category": "public.app-category.social-networking" },
    "linux": { "target": "AppImage", "category": "Network" }
  }
}
